    ];
    var playerAudio = document.getElementById('player-audio');
    var playerToggle = document.getElementById('player-toggle');
    var playerPrev = document.getElementById('player-prev');
    var playerNext = document.getElementById('player-next');
    var playerArt = document.getElementById('player-art');
    var playerTitle = document.getElementById('player-title');
    var playerArtist = document.getElementById('player-artist');
    if (playerAudio && playerToggle) {
      var currentTrack = 0;
      var applyTrack = function(index, autoplay) {
        currentTrack = (index + playerTracks.length) % playerTracks.length;
        var track = playerTracks[currentTrack];
        playerTitle.textContent = track.title;
        playerArtist.textContent = track.artist;
        playerArt.src = track.art;
        playerAudio.src = track.src;
        if (autoplay) playerAudio.play();
      };
      playerPrev.addEventListener('click', function() { applyTrack(currentTrack - 1, !playerAudio.paused); });
      playerNext.addEventListener('click', function() { applyTrack(currentTrack + 1, !playerAudio.paused); });
      playerToggle.addEventListener('click', function() {
        if (!playerAudio.src) { applyTrack(currentTrack, true); return; }
        if (playerAudio.paused) playerAudio.play();
        else playerAudio.pause();
      });
      playerAudio.addEventListener('play', function() { playerToggle.classList.add('playing'); });
      playerAudio.addEventListener('pause', function() { playerToggle.classList.remove('playing'); });
      playerAudio.addEventListener('ended', function() { applyTrack(currentTrack + 1, true); });
      // ← / → switch tracks from anywhere on the page, except while typing or browsing the
      // mood board lightbox, which uses the same keys for photos.
      document.addEventListener('keydown', function(e) {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
        if (document.querySelector('dialog[open]')) return;
        var el = document.activeElement;
        if (el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName))) return;
        applyTrack(currentTrack + (e.key === 'ArrowRight' ? 1 : -1), !playerAudio.paused);
      });
    }

    var heroCard = document.getElementById('hero-card');
    var asciiCard = document.getElementById('ascii-card');
    if (heroCard) {
      var activeCleanup = null;

