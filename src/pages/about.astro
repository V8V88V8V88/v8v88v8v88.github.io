        ghost.removeAttribute('id');
        ghost.style.position = 'fixed';
        ghost.style.margin = '0';
        ghost.style.top = rect.top + 'px';
        ghost.style.left = rect.left + 'px';
        ghost.style.width = rect.width + 'px';
        ghost.style.height = rect.height + 'px';
        ghost.style.zIndex = z;
        ghost.style.pointerEvents = 'none';
        ghost.style.transition = 'none';
        document.body.appendChild(ghost);
        return ghost;
      };

      var setExpanded = function(expanding) {
        var sharesRow = asciiCard && window.innerWidth >= 1025;

        if (!sharesRow) {
          heroCard.classList.toggle('expanded', expanding);
          if (asciiCard) asciiCard.style.display = '';
          return;
        }

        if (activeCleanup) activeCleanup();

        var heroStart = heroCard.getBoundingClientRect();
        var asciiStart = asciiCard.getBoundingClientRect();
        var asciiWasVisible = getComputedStyle(asciiCard).display !== 'none';

        // Expanding: ascii is about to leave flow, so freeze its current look in a
        // disposable ghost (its content never changes, keeps the real element's
        // inline state trivial and race-proof) and fade the ghost out in place.
        var asciiGhost = (expanding && asciiWasVisible) ? pinGhost(asciiCard, asciiStart, '2') : null;

        // Apply the real end-state instantly so content (bio text) is already correct.
        heroCard.classList.toggle('expanded', expanding);
        asciiCard.style.display = expanding ? 'none' : '';

        var heroEnd = heroCard.getBoundingClientRect();

        // Collapsing: ascii is already back in its stable natural spot (it doesn't
        // move), so fade the real element in directly, in sync with hero's shrink.
        if (!expanding) {
          asciiCard.style.transition = 'none';
          asciiCard.style.opacity = '0';
          asciiCard.style.transform = 'scale(0.94)';
          void asciiCard.offsetHeight;
        }

        // Hero card: animate its own real box (pin to start size, release to end size)
        // so the already-laid-out content progressively reveals through the growing
        // box instead of popping in after a content-less ghost finishes resizing.
        heroCard.style.transition = 'none';
        heroCard.style.width = heroStart.width + 'px';
        heroCard.style.height = heroStart.height + 'px';
        heroCard.style.overflow = 'hidden';
        void heroCard.offsetHeight;

        var finished = false;
        var finish = function() {
          if (finished) return;
          finished = true;
          heroCard.style.transition = '';
          heroCard.style.width = '';
          heroCard.style.height = '';
          heroCard.style.overflow = '';
          heroCard.removeEventListener('transitionend', onHeroEnd);
          if (asciiGhost) asciiGhost.remove();
          asciiCard.style.transition = '';
          asciiCard.style.opacity = '';
          asciiCard.style.transform = '';
          if (activeCleanup === finish) activeCleanup = null;
        };
        activeCleanup = finish;

        var onHeroEnd = function(e) {
          if (e.target !== heroCard) return;
          finish();
        };

        requestAnimationFrame(function() {
          requestAnimationFrame(function() {
            heroCard.style.transition = 'width 0.5s cubic-bezier(0.22, 1, 0.36, 1), height 0.5s cubic-bezier(0.22, 1, 0.36, 1)';
            heroCard.style.width = heroEnd.width + 'px';
            heroCard.style.height = heroEnd.height + 'px';
            if (asciiGhost) {
              asciiGhost.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
              asciiGhost.style.opacity = '0';
              asciiGhost.style.transform = 'scale(0.94)';
            }
            if (!expanding) {
              asciiCard.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
              asciiCard.style.opacity = '1';
              asciiCard.style.transform = 'scale(1)';
            }
            heroCard.addEventListener('transitionend', onHeroEnd);
            setTimeout(finish, 650);
          });
        });
      };

      heroCard.addEventListener('click', function(e) {
        if (e.target.closest('a')) return;
        setExpanded(!heroCard.classList.contains('expanded'));
      });
      if (window.location.hash === '#story') {
        heroCard.classList.add('expanded');
        if (asciiCard && window.innerWidth >= 1025) asciiCard.style.display = 'none';
      }
    }

    var canvas = document.getElementById('matrix-canvas');
    if (canvas) {
      var ctx = canvas.getContext('2d');
      function resizeMatrix() { canvas.width = canvas.offsetWidth; canvas.height = canvas.offsetHeight; }
      resizeMatrix();
      window.addEventListener('resize', resizeMatrix);
      var chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      var fontSize = 14;
      var columns = canvas.width / fontSize;
      var drops = [];
      for (var i = 0; i < columns; i++) drops[i] = Math.random() * -100;
      function isLightMode() { return document.body.classList.contains('light-mode'); }
      function drawMatrix() {
        var lightMode = isLightMode();
        ctx.fillStyle = lightMode ? 'rgba(240, 240, 240, 0.1)' : 'rgba(0, 0, 0, 0.05)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = lightMode ? '#0f4d1f' : '#1DB954';
        ctx.font = fontSize + 'px "SF Mono", "Geist Mono", ui-monospace, Menlo, monospace';
        for (var i = 0; i < drops.length; i++) {
          var char = chars[Math.floor(Math.random() * chars.length)];
          ctx.fillText(char, i * fontSize, drops[i] * fontSize);
          if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) drops[i] = 0;
          drops[i]++;
        }
      }
      setInterval(drawMatrix, 50);
      window.addEventListener('resize', function() {
        columns = canvas.width / fontSize;
        drops = [];
        for (var i = 0; i < columns; i++) drops[i] = Math.random() * -100;
      });
      var modeSwitch = document.getElementById('mode-switch');
      if (modeSwitch) {
        modeSwitch.addEventListener('change', function() { ctx.clearRect(0, 0, canvas.width, canvas.height); });
      }
    }


    // Mood board: the front photo slides off the deck and tucks in at the back every few
    // seconds. Autoplay runs only while the card is on screen, the tab is visible, the pointer
    // isn't resting on it and the lightbox is closed. Click/tap opens the front photo large.
    var moodCard = document.querySelector('.bento-mood');
    if (moodCard) {
      var moodDeck = Array.prototype.slice.call(moodCard.querySelectorAll('.mood-tile'));
      var moodTimer = 0;
      var moodVisible = false;
      var moodHovered = false;
      var moodBusy = false;
      var moodReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var moodBox = document.getElementById('mood-lightbox');
      var moodBoxImg = document.getElementById('mood-lightbox-img');
      var moodBoxCaption = document.getElementById('mood-lightbox-caption');
      var layoutMood = function() {
        moodDeck.forEach(function(tile, i) {
          tile.setAttribute('data-depth', i);
          tile.style.zIndex = moodDeck.length - i;
          // Deeper photos only load once they're a couple of turns from the front.
          var img = tile.firstElementChild;
          if (i < 4 && img.dataset.src) { img.src = img.dataset.src; delete img.dataset.src; }
        });
      };
      var nextMood = function() {
        if (moodBusy) return;
        moodBusy = true;
        var front = moodDeck.shift();
        moodDeck.push(front);
        front.classList.add('is-leaving');
        setTimeout(function() {
          layoutMood();
          front.classList.remove('is-leaving');
          moodBusy = false;
        }, 380);
      };
      var syncMood = function() {
        var run = !moodReduce && moodVisible && !moodHovered && !moodBox.open && !document.hidden;
        if (run && !moodTimer) moodTimer = setInterval(nextMood, 3500);
        else if (!run && moodTimer) { clearInterval(moodTimer); moodTimer = 0; }
      };
      var moodEase = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
      var moodBoxFrame = moodBox.querySelector('.mood-lightbox-frame');
      var moodFull = {};
      var moodClosing = false;
      var preloadFull = function(tile) {
        var url = tile.firstElementChild.dataset.full;
        if (!moodFull[url]) {
          var im = new Image();
          im.decoding = 'async';
          im.src = url;
          moodFull[url] = im;
        }
        return moodFull[url];
      };
      var sizeMoodBox = function(img) {
        var fw = +img.dataset.fw, fh = +img.dataset.fh;
        var maxW = Math.min(window.innerWidth * 0.88, 720) - 20;
        var maxH = Math.min(window.innerHeight * (window.innerWidth <= 768 ? 0.62 : 0.74), 720);
        var scale = Math.min(maxW / fw, maxH / fh);
        moodBoxImg.style.width = Math.round(fw * scale) + 'px';
        moodBoxImg.style.height = Math.round(fh * scale) + 'px';
      };
      // Show the deck's front photo. The small copy is already cached, so it goes up instantly
      // and the full-size one replaces it as soon as it has loaded.
      var showMood = function(dir) {
        var tile = moodDeck[0];
        var img = tile.firstElementChild;
        var full = preloadFull(tile);
        sizeMoodBox(img);
        moodBoxImg.dataset.want = full.src;
        if (full.complete && full.naturalWidth) {
          moodBoxImg.src = full.src;
        } else {
          moodBoxImg.src = img.src;
          full.addEventListener('load', function() {
            if (moodBoxImg.dataset.want === full.src) moodBoxImg.src = full.src;
          }, { once: true });
        }
        moodBoxImg.alt = img.alt;
        moodBoxCaption.textContent = img.dataset.caption || img.alt;
        moodDeck.forEach(function(t, i) { t.classList.toggle('is-lifted', i === 0); });
        preloadFull(moodDeck[1]);
        preloadFull(moodDeck[2]);
        preloadFull(moodDeck[moodDeck.length - 1]);
        if (dir && !moodReduce) {
          moodBoxImg.animate([
            { opacity: 0.35, transform: 'translateX(' + dir * 18 + 'px)' },
            { opacity: 1, transform: 'none' }
          ], { duration: 160, easing: moodEase });
        }
      };
      // FLIP: start (or end) the lightbox frame exactly over the front polaroid in the deck.
      var flipMoodBox = function(reverse) {
        var tile = moodDeck[0];
        var from = tile.getBoundingClientRect();
        var to = moodBoxFrame.getBoundingClientRect();
        var scale = tile.offsetWidth / moodBoxFrame.offsetWidth;
        var dx = (from.left + from.width / 2) - (to.left + to.width / 2);
        var dy = (from.top + from.height / 2) - (to.top + to.height / 2);
        var r = getComputedStyle(tile).getPropertyValue('--r').trim() || '0deg';
        var frames = [
          { transform: 'translate(' + dx + 'px, ' + dy + 'px) rotate(' + r + ') scale(' + scale + ')', boxShadow: '0 6px 18px rgba(0, 0, 0, 0.45)' },
          { transform: 'none', boxShadow: '0 24px 60px rgba(0, 0, 0, 0.6)' }
        ];
        if (reverse) frames.reverse();
        return moodBoxFrame.animate(frames, { duration: reverse ? 280 : 360, easing: moodEase });
      };
      var openMoodBox = function() {
        if (moodBox.open) return;
        warmMood();
        // Let an autoplay flip that's already underway land first.
        if (moodBusy) { setTimeout(openMoodBox, 60); return; }
        moodCard.classList.add('is-static');
        moodBox.showModal();
        showMood(0);
        syncMood();
        if (!moodReduce) flipMoodBox(false);
      };
      var closeMoodBox = function() {
        if (!moodBox.open || moodClosing) return;
        moodClosing = true;
        var done = function() { moodClosing = false; moodBox.close(); };
        if (moodReduce) { done(); return; }
        moodBox.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 280, easing: 'ease', pseudoElement: '::backdrop' });
        flipMoodBox(true).onfinish = done;
      };
      var stepMoodBox = function(dir) {
        if (moodClosing) return;
        if (dir > 0) moodDeck.push(moodDeck.shift());
        else moodDeck.unshift(moodDeck.pop());
        layoutMood();
        showMood(dir);
      };
      var moodFontLoaded = false;
      var warmMood = function() {
        preloadFull(moodDeck[0]);
        if (moodFontLoaded) return;
        moodFontLoaded = true;
        var font = document.createElement('link');
        font.rel = 'stylesheet';
        font.href = 'https://fonts.googleapis.com/css2?family=Caveat:wght@500&display=swap';
        document.head.appendChild(font);
      };
      moodCard.addEventListener('pointerenter', warmMood);
      moodCard.addEventListener('focus', warmMood);
      moodCard.addEventListener('touchstart', warmMood, { passive: true });
      moodCard.addEventListener('click', openMoodBox);
      moodCard.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openMoodBox(); }
      });
      document.getElementById('mood-lightbox-prev').addEventListener('click', function() { stepMoodBox(-1); });
      document.getElementById('mood-lightbox-next').addEventListener('click', function() { stepMoodBox(1); });
      document.getElementById('mood-lightbox-close').addEventListener('click', closeMoodBox);
      moodBox.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowRight') { e.preventDefault(); stepMoodBox(1); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); stepMoodBox(-1); }
      });
      // Esc goes through the same animated close.
      moodBox.addEventListener('cancel', function(e) { e.preventDefault(); closeMoodBox(); });
      // Clicking the dimmed backdrop (the dialog itself, outside the photo and buttons) closes it.
      moodBox.addEventListener('click', function(e) { if (e.target === moodBox) closeMoodBox(); });
      moodBox.addEventListener('close', function() {
        moodDeck[0].classList.remove('is-lifted');
        moodBoxImg.removeAttribute('src');
        delete moodBoxImg.dataset.want;
        // Re-enable deck transitions only after the snap has painted.
        requestAnimationFrame(function() { moodCard.classList.remove('is-static'); });
        syncMood();
      });
      new IntersectionObserver(function(entries) {
        moodVisible = entries[0].isIntersecting;
        syncMood();
      }).observe(moodCard);
      document.addEventListener('visibilitychange', syncMood);
      moodCard.addEventListener('mouseenter', function() { moodHovered = true; syncMood(); });
      moodCard.addEventListener('mouseleave', function() { moodHovered = false; syncMood(); });
    }
  </script>
</BaseLayout>

<style>
.about-page {
  min-height: 100vh;
  width: 100%;
  max-width: min(1050px, calc(100% - 2rem));
  margin: 0 auto;
  padding: 104px clamp(1rem, 3.2vw, 2.4rem) 3rem;
}
.bento-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0.95rem; }
.bento-item { min-width: 0; overflow-wrap: anywhere; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 17px; padding: 1.22rem 1.12rem; transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease; position: relative; overflow: hidden; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 4px 24px rgba(0, 0, 0, 0.2); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); text-decoration: none; color: inherit; }
.bento-item::before { content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 70%; height: 1px; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent); }
.bento-item:hover { background: rgba(255, 255, 255, 0.05); border-color: rgba(255, 255, 255, 0.15); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 8px 32px rgba(0, 0, 0, 0.25); transform: translateY(-4px); }
.bento-hero { grid-column: span 8; display: flex; flex-direction: column; justify-content: center; min-height: 232px; position: relative; overflow: hidden; }
.hero-title { font-family: var(--font-serif); font-size: clamp(2.35rem, 1.2rem + 2.9vw, 4.4rem); font-weight: 400; color: #fff; line-height: 1.15; margin-bottom: 0.42rem; }
.hero-title .name { font-style: italic; color: rgba(255, 255, 255, 0.5); transition: color 0.3s ease; }
.bento-hero:hover .hero-title .name { color: #1DB954 !important; }
.hero-subtitle { font-family: var(--font-serif); font-size: clamp(1.1rem, 0.85rem + 0.55vw, 1.45rem); color: rgba(255, 255, 255, 0.55); max-width: 32ch; }
.bento-item.bento-ascii { min-width: 0; container-type: inline-size; }
.bento-ascii { grid-column: span 4; display: flex; align-items: center; justify-content: center; min-height: 232px; font-family: var(--font-mono); font-size: clamp(0.44rem, 0.62vw + 0.33rem, 0.59rem); line-height: 1.15; color: #1DB954; white-space: pre; text-align: center; }
.bento-ascii pre { font-size: min(1em, 8cqw); margin: 0; width: fit-content; max-width: 100%; min-width: 0; margin-inline: auto; box-sizing: border-box; }
.bento-philosophy { grid-column: span 6; display: flex; flex-direction: column; justify-content: center; text-align: center; padding: 1.25rem 1.12rem; gap: 0.7rem; min-height: 226px; }
/* All quotes share a grid cell, so the longest quote reserves enough space
   at every width without colliding with the heading or changing card height. */
.philosophy-carousel { display: grid; align-items: center; min-width: 0; }
.philosophy-carousel > .philosophy-text { grid-area: 1 / 1; min-width: 0; margin: 0; }
.philosophy-text { font-family: var(--font-serif); font-size: var(--fs-xl); font-style: italic; color: rgba(255, 255, 255, 0.75); line-height: 1.45; visibility: hidden; opacity: 0; transition: opacity 0.3s ease; pointer-events: none; max-width: 490px; margin: 0 auto; }
.philosophy-text.active { visibility: visible; opacity: 1; pointer-events: auto; }
.philosophy-text .accent { color: #1DB954; font-style: normal; font-weight: 500; }
.bento-item.clickable, a.bento-item { cursor: pointer; }
.bento-item.clickable:hover, a.bento-item:hover { border-color: rgba(255, 255, 255, 0.15); }
.hero-expanded { display: none; margin-top: 1.1rem; padding-top: 1.1rem; border-top: 1px solid rgba(255, 255, 255, 0.1); }
.hero-expanded p { font-family: var(--font-serif-text); font-size: clamp(1.12rem, 0.9rem + 0.3vw, 1.3rem); color: rgba(255, 255, 255, 0.8); line-height: 1.65; margin-bottom: 1rem; }
.hero-expanded p:last-child { margin-bottom: 0; }
.bento-hero.expanded { justify-content: flex-start; grid-column: span 12; }
.bento-hero.expanded .hero-expanded { display: block; animation: fadeIn 0.3s ease; }
.click-hint { font-family: var(--font-mono); font-size: var(--fs-2xs); color: rgba(255, 255, 255, 0.25); position: absolute; bottom: 1.05rem; right: 1.15rem; text-align: right; transition: opacity 0.3s ease; }
.bento-hero.expanded .click-hint { display: none; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
.bento-mood { grid-column: span 3; min-height: 226px; padding: 0; container-type: size; background: radial-gradient(ellipse at 50% 55%, rgba(29, 185, 84, 0.08) 0%, transparent 70%), rgba(255, 255, 255, 0.03); }
/* Polaroid deck: one photo up front in colour, the next two fanned out behind it, the rest hidden underneath. Sized off the card's smaller side so the deck fits wide desktop and short mobile tiles alike. */
.mood-tile { position: absolute; left: 50%; top: 50%; width: min(54cqw, 68cqh); aspect-ratio: 4 / 5; margin: 0; padding: 5px 5px 16px; background: #ece8df; border-radius: 3px; box-shadow: 0 8px 22px rgba(0, 0, 0, 0.45), 0 1px 3px rgba(0, 0, 0, 0.3); --dx: 0%; --dy: 0%; --r: 3deg; transform: translate(-50%, -50%) translate(var(--dx), var(--dy)) rotate(var(--r)); opacity: 0; transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.5s ease; }
.mood-tile img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 1px; filter: grayscale(1) contrast(1.06) brightness(0.8); transition: filter 0.6s ease; }
.mood-tile[data-depth="0"], .mood-tile[data-depth="1"], .mood-tile[data-depth="2"] { opacity: 1; }
.mood-tile[data-depth="0"] { --r: -2deg; }
.mood-tile[data-depth="0"] img { filter: none; }
.mood-tile[data-depth="1"] { --dx: 24%; --dy: -4%; --r: 8deg; }
.mood-tile[data-depth="2"] { --dx: -24%; --dy: -2%; --r: -9deg; }
.mood-tile.is-leaving { --dx: 125%; --dy: 6%; --r: 16deg; }
/* While the lightbox is open the deck snaps instead of animating, and the front photo is "lifted" out of it. */
.bento-mood.is-static .mood-tile { transition: none; }
.mood-tile.is-lifted { visibility: hidden; }
.bento-mood:hover .mood-tile[data-depth="0"] { --r: 0deg; transform: translate(-50%, -50%) rotate(0deg) scale(1.04); }
.mood-lightbox { width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; color: #fff; display: none; align-items: center; justify-content: center; }
.mood-lightbox[open] { display: flex; }
.mood-lightbox::backdrop { background: rgba(0, 0, 0, 0.82); animation: moodFade 0.3s ease; }
.mood-lightbox[open] .mood-lightbox-btn { animation: moodFade 0.3s ease; }
@keyframes moodFade { from { opacity: 0; } }
.mood-lightbox-frame { will-change: transform; margin: 0; padding: 10px 10px 0; background: #ece8df; border-radius: 4px; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6); display: flex; flex-direction: column; align-items: center; max-width: min(88vw, 720px); }
/* Width and height are set from the photo's known size in JS, so the frame never jumps while a photo loads. */
.mood-lightbox-frame img { display: block; object-fit: cover; border-radius: 2px; background: #d9d4c9; }
/* Captions are handwritten on the polaroid; Caveat is fetched only once someone reaches for the board. */
.mood-lightbox-frame figcaption { font-family: "Caveat", "Segoe Print", "Bradley Hand", cursive; font-size: 1.5rem; font-weight: 500; line-height: 1.2; color: #2a2a2a; padding: 0.35rem 0.6rem 0.6rem; text-align: center; }
.mood-lightbox-btn { position: absolute; width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.18); background: rgba(20, 20, 20, 0.7); color: #fff; font-size: 1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background-color 0.2s ease, border-color 0.2s ease; }
.mood-lightbox-btn:hover { background: rgba(29, 185, 84, 0.25); border-color: rgba(29, 185, 84, 0.6); }
.mood-lightbox-prev { left: max(16px, 4vw); top: 50%; transform: translateY(-50%); }
.mood-lightbox-next { right: max(16px, 4vw); top: 50%; transform: translateY(-50%); }
.mood-lightbox-close { top: 20px; right: max(16px, 4vw); }
@media (max-width: 768px) {
  .mood-lightbox-prev, .mood-lightbox-next { top: auto; bottom: 28px; transform: none; }
  .mood-lightbox-prev { left: calc(50% - 56px); }
  .mood-lightbox-next { right: calc(50% - 56px); }
}
.bento-player { grid-column: span 3; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; gap: 0.6rem; min-height: 226px; }
.player-art { width: 72px; height: 72px; border-radius: 12px; object-fit: cover; flex-shrink: 0; border: 1px solid rgba(255, 255, 255, 0.1); background: rgba(255, 255, 255, 0.04); }
