---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, formatDate } from '../../data/posts';

const posts = getAllPosts();

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "url": "https://v8v88v8v88.com/blogs/",
  "name": "V8V88V8V88 Blog",
  "description": "Blog posts by V8V88V8V88 on Linux, Minimalism, Identity, and more.",
  "publisher": {
    "@type": "Person",
    "name": "Vaibhav Pratap Singh",
    "alternateName": "V8V88V8V88",
    "url": "https://v8v88v8v88.com/"
  }
};
---
<BaseLayout
  title="Blogs | V8"
  description="Blog posts by V8V88V8V88 on Linux, Minimalism, Identity, and more."
  canonical="https://v8v88v8v88.com/blogs/"
  ogImage="https://v8v88v8v88.com/images/username.png"
  showRss={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
  </Fragment>

  <main>
    <section class="hero">
      <div class="hero-glow"></div>
      <div class="hero-highlight"></div>
      <div class="hero-content">
        <h1>I write, <i>maybe?</i></h1>
        <p>The answer to the ultimate question of life, the universe, and everything...</p>
      </div>
    </section>

    <section class="posts-grid">
      {posts.map((post, i) => (
        <a class="post-card" href={`/${post.slug}/`} style={`--post-img: url('${post.image}')`}>
          <div class="post-image" aria-hidden="true"></div>
          {i === 0 && <span class="post-badge">Latest</span>}
          <div class="post-content">
            <div class="post-meta">
              <time datetime={post.date}>{formatDate(post.date)}</time>
              {post.readTime && <><span class="post-meta-dot" aria-hidden="true">·</span><span>{post.readTime}</span></>}
            </div>
            <h2 class="post-title">{post.title}</h2>
            <p class="post-excerpt">{post.description}</p>
            <div class="post-footer">
              {post.tags && (
                <div class="post-tags">
                  {post.tags.map((tag) => (
                    <span class="post-tag">{tag}</span>
                  ))}
                </div>
              )}
              <span class="post-cta" aria-hidden="true">Read <span class="post-cta-arrow">→</span></span>
            </div>
          </div>
        </a>
      ))}
    </section>
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
      const hero = document.querySelector(".hero");
      if (hero) {
        hero.addEventListener("mousemove", (e) => {
          const rect = hero.getBoundingClientRect();
          const x = ((e.clientX - rect.left) / rect.width) * 100;
          const y = ((e.clientY - rect.top) / rect.height) * 100;
          hero.style.setProperty("--mouse-x", x + "%");
          hero.style.setProperty("--mouse-y", y + "%");
        });
      }
    });
  </script>
</BaseLayout>

<style>
  main {
    padding: 4rem 2rem 2rem;
    max-width: var(--page-max-width);
    margin: 0 auto;
  }

  .hero {
    position: relative;
    height: clamp(220px, 26vh, 290px);
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    margin: 1rem auto 3rem;
    border-radius: 24px;
    background: linear-gradient(145deg, #0a0a0a 0%, #1a1a1a 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: border-color 0.4s ease, box-shadow 0.4s ease;
    isolation: isolate;
  }

  .hero:hover {
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.05),
      0 8px 40px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(255, 255, 255, 0.03) 0%, transparent 50%);
    z-index: 1;
    transition: opacity 0.4s ease;
  }

  .hero-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.4s ease;
    background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(255, 255, 255, 0.08) 0%,
        rgba(255, 255, 255, 0.03) 25%,
        transparent 50%);
  }

  .hero:hover .hero-glow {
    opacity: 1;
  }

  .hero-highlight {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg,
        transparent 0%,
        rgba(255, 255, 255, 0.3) 20%,
        rgba(255, 255, 255, 0.5) 50%,
        rgba(255, 255, 255, 0.3) 80%,
        transparent 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 10;
  }

  .hero:hover .hero-highlight {
    opacity: 1;
  }

  .hero::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      linear-gradient(45deg,
        rgba(255, 255, 255, 0.02) 25%,
        transparent 25%,
        transparent 75%,
        rgba(255, 255, 255, 0.02) 75%),
      linear-gradient(45deg,
        rgba(255, 255, 255, 0.02) 25%,
        transparent 25%,
        transparent 75%,
        rgba(255, 255, 255, 0.02) 75%);
    background-size: 40px 40px;
    background-position: 0 0, 20px 20px;
    opacity: 0.5;
    z-index: 3;
  }

  .hero-content {
    position: relative;
    z-index: 3;
    text-align: center;
    max-width: 700px;
    padding: 0 2rem;
  }

  .hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.65rem, 6.2vw, 4.2rem);
    font-weight: 400;
    margin-bottom: 0.75rem;
    color: #fff;
    letter-spacing: -0.02em;
  }

  /* "maybe?" sits on a gold-leaf gradient that only shows through on hover. */
  .hero h1 i {
    font-style: italic;
    color: rgba(255, 255, 255, 0.6);
    padding-right: 0.08em;
    background: linear-gradient(105deg, #b8862e 0%, #e9c97a 35%, #fff1c9 50%, #e9c97a 65%, #b8862e 100%);
    background-size: 250% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: rgba(255, 255, 255, 0.6);
    transition: -webkit-text-fill-color 0.6s ease, background-position 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero:hover h1 i {
    -webkit-text-fill-color: transparent;
    background-position: 0% 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero h1 i {
      transition: -webkit-text-fill-color 0.3s ease;
    }
  }

  .hero p {
    font-size: clamp(1.08rem, 2.1vw, 1.32rem);
    color: rgba(255, 255, 255, 0.5);
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.6;
    font-weight: 400;
  }

  :global(body.light-mode) .hero {
    background: linear-gradient(145deg, rgba(0, 0, 0, 0.02) 0%, rgba(0, 0, 0, 0.06) 100%);
    border-color: rgba(0, 0, 0, 0.08);
  }

  :global(body.light-mode) .hero:hover {
    border-color: rgba(0, 0, 0, 0.12);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.5),
      0 8px 40px rgba(0, 0, 0, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  :global(body.light-mode) .hero::before {
    background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(255, 255, 255, 0.5) 0%, transparent 50%);
  }

  :global(body.light-mode) .hero-glow {
    background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(255, 255, 255, 0.6) 0%,
        rgba(255, 255, 255, 0.2) 25%,
        transparent 50%);
  }

  :global(body.light-mode) .hero-highlight {
    background: linear-gradient(90deg,
        transparent 0%,
        rgba(255, 255, 255, 0.8) 20%,
        rgba(255, 255, 255, 1) 50%,
        rgba(255, 255, 255, 0.8) 80%,
        transparent 100%);
  }

  :global(body.light-mode) .hero::after {
    background:
      linear-gradient(45deg,
        rgba(0, 0, 0, 0.02) 25%,
        transparent 25%,
        transparent 75%,
        rgba(0, 0, 0, 0.02) 75%),
      linear-gradient(45deg,
        rgba(0, 0, 0, 0.02) 25%,
        transparent 25%,
        transparent 75%,
        rgba(0, 0, 0, 0.02) 75%);
    opacity: 0.6;
  }

  :global(body.light-mode) .hero h1 {
    color: #1d1d1f;
  }

  :global(body.light-mode) .hero h1 i {
    color: rgba(0, 0, 0, 0.5);
    -webkit-text-fill-color: rgba(0, 0, 0, 0.5);
    background-image: linear-gradient(105deg, #7a5410 0%, #b98a2c 35%, #d9ad52 50%, #b98a2c 65%, #7a5410 100%);
  }

  :global(body.light-mode) .hero:hover h1 i {
    -webkit-text-fill-color: transparent;
  }

  :global(body.light-mode) .hero p {
    color: rgba(0, 0, 0, 0.5);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: clamp(1rem, 1.6vw, 1.5rem);
    margin-top: 0.35rem;
    padding: 0 clamp(0px, 2vw, 2rem);
    background-color: transparent;
  }

  /* Sharp cover on top that dissolves into a blurred copy of itself behind the text. */
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    isolation: isolate;
    text-decoration: none;
    color: #fff;
    background: #0d0d0d;
    box-shadow:
      0 12px 32px -10px rgba(0, 0, 0, 0.6);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .post-card::before {
    content: "";
    position: absolute;
    inset: -40px;
    z-index: -2;
    background: var(--post-img) center / cover no-repeat;
    filter: blur(40px) saturate(130%) brightness(0.32);
  }

  .post-card:hover {
    transform: translateY(-5px);
    box-shadow:
      0 22px 44px -12px rgba(0, 0, 0, 0.75);
  }

  .post-card:focus-visible {
    outline: 2px solid #e9c97a;
    outline-offset: 3px;
  }

  .post-image {
    aspect-ratio: 1.618 / 1;
    background: var(--post-img) center / cover no-repeat;
    -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
    transform-origin: center top;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .post-card:hover .post-image {
    transform: scale(1.04);
  }

  .post-badge {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    font-size: var(--fs-2xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.25);
  }

  .post-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0.35rem clamp(1.1rem, 1.5vw, 1.4rem) clamp(1.1rem, 1.5vw, 1.35rem);
    margin-top: -1.25rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-xs);
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 0.45rem;
  }

  .post-title {
    font-size: clamp(1.15rem, 1.25vw, 1.35rem);
    font-weight: 600;
    margin: 0 0 0.4rem;
    color: #fff;
    line-height: 1.25;
    letter-spacing: -0.015em;
    transition: color 0.2s ease;
  }

  /* Same gold-leaf reveal as the hero's "maybe?". */
  .post-title {
    background: linear-gradient(105deg, #b8862e 0%, #e9c97a 35%, #fff1c9 50%, #e9c97a 65%, #b8862e 100%);
    background-size: 250% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: #fff;
    transition: -webkit-text-fill-color 0.5s ease, background-position 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .post-card:hover .post-title,
  .post-card:focus-visible .post-title {
    -webkit-text-fill-color: transparent;
    background-position: 0% 0;
  }

  .post-excerpt {
    font-size: var(--fs-sm);
    margin: 0 0 1rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .post-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    min-width: 0;
  }

  .post-tag {
    background: rgba(255, 255, 255, 0.09);
    color: rgba(255, 255, 255, 0.85);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: var(--fs-xs);
    font-weight: 500;
    box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.14);
  }

  .post-cta {
    flex-shrink: 0;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.75);
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .post-cta-arrow {
    display: inline-block;
    transition: transform 0.25s ease;
  }

  .post-card:hover .post-cta {
    color: #e9c97a;
  }

  .post-card:hover .post-cta-arrow {
    transform: translateX(3px);
  }

  :global(body.light-mode) .post-card {
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.1),
      0 12px 32px -10px rgba(0, 0, 0, 0.25);
  }

  :global(body.light-mode) .post-card:hover {
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.14),
      0 22px 44px -12px rgba(0, 0, 0, 0.35);
  }

  /* Hero-style hairline drawn above the cover so it reads all the way round. */
  .post-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid rgba(255, 255, 255, 0.08);
    pointer-events: none;
    z-index: 3;
    transition: border-color 0.35s ease;
  }
  .post-card:hover::after { border-color: rgba(255, 255, 255, 0.15); }
  :global(body.light-mode) .post-card::after { border-color: rgba(0, 0, 0, 0.08); }
  :global(body.light-mode) .post-card:hover::after { border-color: rgba(0, 0, 0, 0.12); }

  /* Light: cover dissolves into a pale frosted copy of itself, text goes dark. */
  :global(body.light-mode) .post-card {
    color: #1d1d1f;
    background: #f5f4f1;
  }
  :global(body.light-mode) .post-card::before {
    filter: blur(48px) saturate(160%) brightness(1.7);
    opacity: 0.35;
  }
  /* Cream veil so dark covers don't turn the text area muddy grey; only a tint of the image survives. */
  :global(body.light-mode) .post-content {
    background: linear-gradient(to bottom, rgba(245, 244, 241, 0) 0, rgba(245, 244, 241, 0.82) 2.75rem, rgba(245, 244, 241, 0.92) 100%);
  }
  :global(body.light-mode) .post-meta { color: rgba(0, 0, 0, 0.5); }
  :global(body.light-mode) .post-title {
    color: #1d1d1f;
    -webkit-text-fill-color: #1d1d1f;
    background-image: linear-gradient(105deg, #7a5410 0%, #b98a2c 35%, #d9ad52 50%, #b98a2c 65%, #7a5410 100%);
  }
  :global(body.light-mode) .post-card:hover .post-title,
  :global(body.light-mode) .post-card:focus-visible .post-title {
    -webkit-text-fill-color: transparent;
  }
  :global(body.light-mode) .post-excerpt { color: rgba(0, 0, 0, 0.68); }
  :global(body.light-mode) .post-tag {
    background: rgba(255, 255, 255, 0.55);
    color: rgba(0, 0, 0, 0.75);
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.12);
  }
  :global(body.light-mode) .post-cta { color: rgba(0, 0, 0, 0.7); }
  :global(body.light-mode) .post-card:hover .post-cta { color: #9a6d1c; }
  :global(body.light-mode) .post-card:focus-visible { outline-color: #b98a2c; }

  @media (max-width: 768px) {
    main {
      padding: 5rem 0.85rem 1rem;
    }

    .hero {
      height: auto;
      min-height: min(30vh, 220px);
      padding: 1.75rem 1.35rem;
      margin: 0.35rem auto 2rem;
      border-radius: 20px;
    }

    .hero-content {
      padding: 0 1rem;
    }

    .hero h1 {
      font-size: clamp(2.28rem, 6.4vw, 2.95rem);
      margin-bottom: 0.55rem;
    }

    .hero p {
      font-size: var(--fs-md);
      line-height: 1.55;
    }

    .posts-grid {
      grid-template-columns: 1fr;
      gap: 0.85rem;
      margin-top: 0.5rem;
    }

    .post-card {
      border-radius: 18px;
    }

    .post-image {
      aspect-ratio: 2.4 / 1;
    }

    .post-content {
      margin-top: -1.75rem;
    }
  }

  @media (max-width: 480px) {
    main {
      padding: 5rem 0.75rem 0.85rem;
    }

    .hero {
      min-height: min(30vh, 200px);
      padding: 1.5rem 1.1rem;
      margin-bottom: 1.75rem;
      border-radius: 16px;
    }

    .hero h1 {
      font-size: var(--fs-2xl);
    }

    .hero p {
      font-size: var(--fs-base);
    }

    .post-card {
      border-radius: 16px;
    }

    .post-image {
      aspect-ratio: 2.8 / 1;
    }

    .post-content {
      padding: 0.25rem 0.9rem 0.85rem;
    }

    .post-meta {
      font-size: var(--fs-2xs);
      margin-bottom: 0.3rem;
    }

    .post-title {
      font-size: var(--fs-base);
    }

    .post-excerpt {
      font-size: var(--fs-xs);
      margin-bottom: 0.6rem;
      -webkit-line-clamp: 1;
    }

    .post-tag {
      font-size: var(--fs-2xs);
      padding: 0.16rem 0.5rem;
    }
  }
</style>
