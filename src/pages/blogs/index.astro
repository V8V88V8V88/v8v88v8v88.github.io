---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getAllPosts, formatDate } from '../../data/posts';

const posts = getAllPosts();

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "url": "https://v8v88v8v88.com/blogs/",
  "name": "V8V88V8V88 Blog",
  "description": "Blog posts by V8V88V8V88 on Linux, Minimalism, Identity, and more.",
  "publisher": {
    "@type": "Person",
    "name": "Vaibhav Pratap Singh",
    "alternateName": "V8V88V8V88",
    "url": "https://v8v88v8v88.com/"
  }
};
---
<BaseLayout
  title="Blogs | V8"
  description="Blog posts by V8V88V8V88 on Linux, Minimalism, Identity, and more."
  canonical="https://v8v88v8v88.com/blogs/"
  ogImage="https://v8v88v8v88.com/images/username.png"
  showRss={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
  </Fragment>

  <main>
    <section class="hero">
      <div class="hero-glow"></div>
      <div class="hero-highlight"></div>
      <div class="hero-content">
        <h1>I write, <i>maybe?</i></h1>
        <p>The answer to the ultimate question of life, the universe, and everything...</p>
      </div>
    </section>

    <section class="posts-grid card-grid">
      {posts.map((post, i) => (
        <Card
          href={`/${post.slug}/`}
          image={post.image}
          imageHasTitle={post.coverHasTitle}
          badge={i === 0 ? 'Latest' : undefined}
          title={post.title}
          description={post.description}
          tags={post.tags}
          cta="Read"
        >
          <Fragment slot="meta">
            <time datetime={post.date}>{formatDate(post.date)}</time>
            {post.readTime && <><span aria-hidden="true">·</span><span>{post.readTime}</span></>}
          </Fragment>
        </Card>
      ))}
    </section>
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
      const hero = document.querySelector(".hero");
      if (hero) {
        hero.addEventListener("mousemove", (e) => {
          const rect = hero.getBoundingClientRect();
          const x = ((e.clientX - rect.left) / rect.width) * 100;
          const y = ((e.clientY - rect.top) / rect.height) * 100;
          hero.style.setProperty("--mouse-x", x + "%");
          hero.style.setProperty("--mouse-y", y + "%");
        });
      }
    });
  </script>
</BaseLayout>

<style>
  main {
    padding: 4rem 2rem 2rem;
    max-width: var(--page-max-width);
    margin: 0 auto;
  }

  .hero {
    position: relative;
    height: clamp(220px, 26vh, 290px);
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    margin: 1rem auto 3rem;
    border-radius: 24px;
    background: linear-gradient(145deg, #0a0a0a 0%, #1a1a1a 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: border-color 0.4s ease, box-shadow 0.4s ease;
    isolation: isolate;
  }

  .hero:hover {
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.05),
      0 8px 40px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(255, 255, 255, 0.03) 0%, transparent 50%);
    z-index: 1;
    transition: opacity 0.4s ease;
  }

  .hero-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.4s ease;
    background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(255, 255, 255, 0.08) 0%,
        rgba(255, 255, 255, 0.03) 25%,
        transparent 50%);
  }

  .hero:hover .hero-glow {
    opacity: 1;
  }

  .hero-highlight {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg,
        transparent 0%,
        rgba(255, 255, 255, 0.3) 20%,
        rgba(255, 255, 255, 0.5) 50%,
        rgba(255, 255, 255, 0.3) 80%,
        transparent 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 10;
  }

  .hero:hover .hero-highlight {
    opacity: 1;
  }

  .hero::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      linear-gradient(45deg,
        rgba(255, 255, 255, 0.02) 25%,
        transparent 25%,
        transparent 75%,
        rgba(255, 255, 255, 0.02) 75%),
      linear-gradient(45deg,
        rgba(255, 255, 255, 0.02) 25%,
        transparent 25%,
        transparent 75%,
        rgba(255, 255, 255, 0.02) 75%);
    background-size: 40px 40px;
    background-position: 0 0, 20px 20px;
    opacity: 0.5;
    z-index: 3;
  }

  .hero-content {
    position: relative;
    z-index: 3;
    text-align: center;
    max-width: 700px;
    padding: 0 2rem;
  }

  .hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.65rem, 6.2vw, 4.2rem);
    font-weight: 400;
    margin-bottom: 0.75rem;
    color: #fff;
    letter-spacing: -0.02em;
  }

  /* "maybe?" sits on a gold-leaf gradient that only shows through on hover. */
  .hero h1 i {
    font-style: italic;
    color: rgba(255, 255, 255, 0.6);
    padding-right: 0.08em;
    background: linear-gradient(105deg, #b8862e 0%, #e9c97a 35%, #fff1c9 50%, #e9c97a 65%, #b8862e 100%);
    background-size: 250% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: rgba(255, 255, 255, 0.6);
    transition: -webkit-text-fill-color 0.6s ease, background-position 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero:hover h1 i {
    -webkit-text-fill-color: transparent;
    background-position: 0% 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero h1 i {
      transition: -webkit-text-fill-color 0.3s ease;
    }
  }

  .hero p {
    font-size: clamp(1.08rem, 2.1vw, 1.32rem);
    color: rgba(255, 255, 255, 0.5);
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.6;
    font-weight: 400;
  }

  :global(html.light-mode) .hero {
    background: linear-gradient(145deg, rgba(0, 0, 0, 0.02) 0%, rgba(0, 0, 0, 0.06) 100%);
    border-color: rgba(0, 0, 0, 0.08);
  }

  :global(html.light-mode) .hero:hover {
    border-color: rgba(0, 0, 0, 0.12);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.5),
      0 8px 40px rgba(0, 0, 0, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  :global(html.light-mode) .hero::before {
    background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(255, 255, 255, 0.5) 0%, transparent 50%);
  }

  :global(html.light-mode) .hero-glow {
    background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(255, 255, 255, 0.6) 0%,
        rgba(255, 255, 255, 0.2) 25%,
        transparent 50%);
  }

  :global(html.light-mode) .hero-highlight {
    background: linear-gradient(90deg,
        transparent 0%,
        rgba(255, 255, 255, 0.8) 20%,
        rgba(255, 255, 255, 1) 50%,
        rgba(255, 255, 255, 0.8) 80%,
        transparent 100%);
  }

  :global(html.light-mode) .hero::after {
    background:
      linear-gradient(45deg,
        rgba(0, 0, 0, 0.02) 25%,
        transparent 25%,
        transparent 75%,
        rgba(0, 0, 0, 0.02) 75%),
      linear-gradient(45deg,
        rgba(0, 0, 0, 0.02) 25%,
        transparent 25%,
        transparent 75%,
        rgba(0, 0, 0, 0.02) 75%);
    opacity: 0.6;
  }

  :global(html.light-mode) .hero h1 {
    color: #1d1d1f;
  }

  :global(html.light-mode) .hero h1 i {
    color: rgba(0, 0, 0, 0.5);
    -webkit-text-fill-color: rgba(0, 0, 0, 0.5);
    background-image: linear-gradient(105deg, #7a5410 0%, #b98a2c 35%, #d9ad52 50%, #b98a2c 65%, #7a5410 100%);
  }

  :global(html.light-mode) .hero:hover h1 i {
    -webkit-text-fill-color: transparent;
  }

  :global(html.light-mode) .hero p {
    color: rgba(0, 0, 0, 0.5);
  }

  .posts-grid {
    justify-content: center;
    margin-top: 0.35rem;
    padding: 0 clamp(0px, 2vw, 2rem);
    background-color: transparent;
  }

  @media (max-width: 768px) {
    main {
      padding: 5rem 0.85rem 1rem;
    }

    .hero {
      height: auto;
      min-height: min(30vh, 220px);
      padding: 1.75rem 1.35rem;
      margin: 0.35rem auto 2rem;
      border-radius: 20px;
    }

    .hero-content {
      padding: 0 1rem;
    }

    .hero h1 {
      font-size: clamp(2.28rem, 6.4vw, 2.95rem);
      margin-bottom: 0.55rem;
    }

    .hero p {
      font-size: var(--fs-md);
      line-height: 1.55;
    }

    .posts-grid {
      margin-top: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    main {
      padding: 5rem 0.75rem 0.85rem;
    }

    /* Keep desktop's hierarchy on phones: the heading stays ~2.7x the card
       text (it used to drop to ~29px while the subtitle stayed 16px, as big
       as the post titles), the subtitle sits under the post titles, and the
       box hugs its text instead of holding a 200px minimum. */
    .hero {
      min-height: 0;
      padding: 1.75rem 1.1rem;
      margin-bottom: 1.75rem;
      border-radius: 16px;
    }

    .hero h1 {
      font-size: clamp(1.95rem, 7.5vw + 0.3rem, 2.4rem);
    }

    .hero p {
      font-size: var(--fs-sm);
      text-wrap: balance;
    }
  }
</style>
