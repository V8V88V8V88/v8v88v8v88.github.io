  .dock-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0 0 2px;
    position: relative;
    max-width: 100%;
  }

  /* macOS Sequoia Liquid Glass Dock Tray */
  .macos-dock {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    border-radius: 26px;
    background: rgba(26, 29, 34, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    box-shadow:
      0 16px 48px -12px rgba(0, 0, 0, 0.65),
      0 3px 8px rgba(0, 0, 0, 0.14);
    user-select: none;
    touch-action: manipulation;
  }

  /* Floating Apple-style Tooltip */
  .dock-tooltip {
    position: absolute;
    top: -36px;
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0.02) 100%),
      rgba(16, 20, 28, 0.88);
    border: 0.5px solid rgba(255, 255, 255, 0.24);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.35);
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro', system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    padding: 3px 9px;
    border-radius: 7px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.16s ease, transform 0.16s cubic-bezier(0.34, 1.56, 0.64, 1);
    white-space: nowrap;
    z-index: 100;
  }

  .dock-tooltip.visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .dock-tooltip::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 6px;
    height: 6px;
    background: rgba(16, 20, 28, 0.9);
    border-right: 0.5px solid rgba(255, 255, 255, 0.24);
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.24);
  }

  /* Dock Items */
  .macos-dock .dock-item,
  .macos-dock .dock-item:hover {
    background: transparent;
    border-radius: 12px;
  }

  .macos-dock .dock-item:hover {
    transform: none;
  }

  .dock-item {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    transform-origin: bottom center;
    will-change: transform;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    padding: 2px 0;
  }

  /* Translucent Liquid Glass Squircle Tiles (macOS Sequoia Tinted/Glass Spec) */
  .dock-icon-tile {
    width: 44px;
    height: 44px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 4px 10px -4px rgba(0, 0, 0, 0.3);
    transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, filter 0.25s ease;
  }

  /* Frosted Silver/White Iconography */
  .dock-glyph {
    position: relative;
    z-index: 3;
    font-size: 1.32rem;
    color: rgba(255, 255, 255, 0.88);
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.35));
    transition: color 0.2s ease, filter 0.2s ease, transform 0.2s ease;
  }

  .dock-terminal-glyph {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
  }

  /* Interactive Hover State: Elevate, Internal Tint Inside & Bright White Glyph */
  .dock-item:hover .dock-icon-tile {
    background: var(--tile-tint, rgba(255, 255, 255, 0.09));
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 8px 18px -6px rgba(0, 0, 0, 0.35);
    filter: brightness(1.06);
  }

  .dock-item:hover .dock-glyph {
    color: #ffffff;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.45));
  }

  .dock-item:active {
    transform: scale(0.94) translateY(1px) !important;
  }

  /* Discrete Apple Indicator Dot (Appears smoothly on hover) */
  .dock-dot {
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%) scale(0.5);
    width: 3.5px;
    height: 3.5px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 0 4px rgba(255, 255, 255, 0.9);
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }

  .dock-item:hover .dock-dot {
    opacity: 1;
    transform: translateX(-50%) scale(1);
  }

  /* Subtle Internal Tint Accents on Hover (Zero External Leakage) */
  .dock-item[data-contact="email"] {
    --tile-tint: rgba(56, 140, 246, 0.22);
    --tile-base: rgba(25, 45, 75, 0.65);
  }

  .dock-item[data-contact="github"] {
    --tile-tint: rgba(255, 255, 255, 0.15);
    --tile-base: rgba(45, 50, 60, 0.65);
  }

  .dock-item[data-contact="telegram"] {
    --tile-tint: rgba(46, 168, 233, 0.22);
    --tile-base: rgba(25, 55, 75, 0.65);
  }

  .dock-item[data-contact="youtube"] {
    --tile-tint: rgba(255, 56, 56, 0.22);
    --tile-base: rgba(75, 25, 25, 0.65);
  }

  .dock-item[data-contact="instagram"] {
    --tile-tint: rgba(225, 48, 108, 0.22);
    --tile-base: rgba(70, 25, 55, 0.65);
  }

  .dock-item[data-contact="twitter"] {
    --tile-tint: rgba(255, 255, 255, 0.15);
    --tile-base: rgba(40, 45, 55, 0.65);
  }

  .dock-item[data-contact="reddit"] {
    --tile-tint: rgba(255, 87, 34, 0.22);
    --tile-base: rgba(75, 40, 25, 0.65);
  }

  .dock-item[data-contact="myanimelist"] {
    --tile-tint: rgba(68, 110, 201, 0.22);
    --tile-base: rgba(30, 48, 80, 0.65);
  }

  .dock-item[data-contact="linkedin"] {
    --tile-tint: rgba(13, 121, 226, 0.22);
    --tile-base: rgba(20, 50, 80, 0.65);
  }

  .dock-item[data-contact="mastodon"] {
    --tile-tint: rgba(116, 117, 255, 0.22);
    --tile-base: rgba(45, 45, 80, 0.65);
  }

  /* Reset button styles for dock item button */
  button.dock-item {
    background: none;
    border: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
    padding: 2px 0;
    margin: 0;
    outline: none;
  }

  /* macOS Dock Divider */
  .dock-divider {
    width: 1px;
    height: 32px;
    margin: 0 4px;
    background: linear-gradient(180deg,
      rgba(255, 255, 255, 0.05) 0%,
      rgba(255, 255, 255, 0.28) 50%,
      rgba(255, 255, 255, 0.05) 100%
    );
    box-shadow: 1px 0 0 rgba(0, 0, 0, 0.25);
    align-self: center;
    flex-shrink: 0;
  }

  /* Active indicator dot for running app (Terminal) */
  .dock-dot.active {
    opacity: 1 !important;
    transform: translateX(-50%) scale(1) !important;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 0 4px rgba(255, 255, 255, 0.9), 0 0 8px rgba(90, 247, 142, 0.4);
  }

  /* Terminal App Tile Hover Glow */
  .dock-item[data-contact="terminal"] {
    --tile-tint: rgba(90, 247, 142, 0.18);
    --tile-base: rgba(20, 36, 28, 0.65);
  }

  /* macOS Landing bounce when window minimizes into dock */
  @keyframes dockLanding {
    0% { transform: scale(1); }
    35% { transform: scale(1.18) translateY(-6px); }
    70% { transform: scale(0.95) translateY(1px); }
    100% { transform: scale(1) translateY(0); }
  }

  .dock-item.dock-landing {
    animation: dockLanding 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }



