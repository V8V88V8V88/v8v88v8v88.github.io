.project-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.project-item {
  padding: 1rem 1rem;
  margin: 0 -1rem;
  min-height: 5.3rem;
  border-radius: 18px;
  text-decoration: none;
  position: relative;
  overflow: visible;
  z-index: auto;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.045) 0%, rgba(255, 255, 255, 0.015) 100%),
    rgb(7, 7, 7);
  /* Opaque fills (the old translucent tints flattened onto the page colour)
     replace the global .project-item backdrop blur, which this list doesn't need. */
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  border: 1px solid rgba(255, 255, 255, 0.06);
  box-shadow:
    inset 0 1px 0 0 rgba(255, 255, 255, 0.08),
    0 8px 24px -10px rgba(0, 0, 0, 0.6);
  transition:
    background 0.3s ease,
    border-color 0.3s ease,
    box-shadow 0.35s ease,
    opacity 0.3s ease,
    transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  /* Off-screen rows skip layout/paint entirely, so a hover-triggered height
     change (desc growing to 2 lines, hosted-link padding) only ever has to
     reflow/repaint the handful of rows actually on screen, not all 55+. */
  content-visibility: auto;
  contain-intrinsic-size: auto 5.6rem;
}

.project-main-link {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 1.25rem;
  align-items: center;
  color: #fff;
  text-decoration: none;
  /* global.css pads every .project-item a by 1rem (home cards), which made
     the rows too tall; a little breathing room is enough here. */
  padding-top: 0.3rem;
  padding-bottom: 0.3rem;
  transition: padding-left 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}

.project-main-link:focus-visible {
  outline: 1px solid rgba(29, 185, 84, 0.7);
  outline-offset: 0.35rem;
  border-radius: 0.2rem;
}

@media (hover: hover) and (pointer: fine) {.project-item:hover,
.project-item:has(:focus-visible) {
  z-index: 30;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.07) 0%, rgba(255, 255, 255, 0.025) 100%),
    rgb(10, 10, 10);
  border-color: rgba(255, 255, 255, 0.14);
  box-shadow:
    inset 0 1px 0 0 rgba(255, 255, 255, 0.22),
    inset 0 -1px 0 0 rgba(255, 255, 255, 0.08),
    0 12px 32px -4px rgba(0, 0, 0, 0.5);
}}

@media (hover: hover) and (pointer: fine) {/* content-visibility: auto always forces paint containment (clips overflow)
   even while rendered, which traps the pop-out preview inside the row.
   .cv-active (set by JS for the hover/focus duration plus the retract
   transition) drops back to normal rendering so the preview can escape the
   row's box exactly like before; every other row keeps content-visibility:
   auto for the off-screen perf win. Only rows with a real image can pop out,
   so plain rows keep their containment (and cheap, row-scoped layout) even
   while hovered. */
.project-item.cv-active:has(.project-preview.has-custom-image) {
  content-visibility: visible;
}

.project-item.cv-active {
  /* A dimmed row (opacity < 1) becomes its own stacking context, so keep the
     row whose preview is still retracting above its neighbours. */
  z-index: 20;
}}

/* Registered and non-inheriting, so updating them on a row restyles only that
   row, not every element inside it. */
@property --fe-d {
  syntax: '<number>';
  inherits: false;
  initial-value: 4;
}

@property --fe-dir {
  syntax: '<number>';
  inherits: false;
  initial-value: 0;
}

/* Fisheye dial: while the pointer is over the list (or a row has keyboard
   focus) the focal row lifts to the front at full brightness and the others
   recede with distance (--fe-d, 0-4, set by JS): dimmer, smaller, and tilted
   away like rows on a drum (--fe-dir: -1 above, 1 below). Hovering the list
   rather than each row keeps the gaps between rows from flashing back. */
@media (hover: hover) and (pointer: fine) {.project-list:hover .project-item:not(:hover),
.project-list:has(:focus-visible) .project-item:not(:has(:focus-visible)) {
  opacity: max(0.3, 0.78 - var(--fe-d, 4) * 0.14);
}}

@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {.project-list:hover .project-item:not(:hover),
.project-list:has(:focus-visible) .project-item:not(:has(:focus-visible)) {
  transform:
    perspective(1200px)
    rotateX(calc(var(--fe-dir, 0) * var(--fe-d, 4) * -2.5deg))
    scale(calc(1 - var(--fe-d, 4) * 0.02));
}

.project-list:hover .project-item:hover,
.project-list:has(:focus-visible) .project-item:has(:focus-visible) {
  transform: scale(1.015);
}}

/* Hover intent: the hosted link waits a beat so sweeping the cursor across
   the list doesn't fire every row; leaving still retracts immediately. */
@media (hover: hover) and (pointer: fine) {.project-item:hover .project-hover-info {
  transition-delay: 90ms;
}}

