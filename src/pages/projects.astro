---
import { existsSync } from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import Shelf from '../components/Shelf.astro';
import { getProjects, pinnedRepos, projectOrder } from '../data/projects';
import { getLanguageMeta } from '../data/languageIcons';
import { iconSvg } from '../data/icons';
import { createSvgSprite } from '../data/svgSprite';
import sharp from 'sharp';

const projects = await getProjects();

const sprite = createSvgSprite('icon-');
const langIcons = new Map(projects.map(p => [p.language, sprite.ref(getLanguageMeta(p.language).svg)]));
const globeIcon = sprite.ref(iconSvg('fas fa-globe'));
const githubIcon = sprite.ref(iconSvg('fab fa-github'));
const spriteMarkup = sprite.render();

const pinned = pinnedRepos
  .map(name => projects.find(p => p.repoName.toLowerCase() === name.toLowerCase()))
  .filter((p): p is (typeof projects)[number] => Boolean(p));
const pinnedNames = new Set(pinned.map(p => p.repoName));
const orderIndex = new Map(projectOrder.map((name, i) => [name.toLowerCase(), i]));
const byStrength = (a: (typeof projects)[number], b: (typeof projects)[number]) =>
  (orderIndex.get(a.repoName.toLowerCase()) ?? Infinity) - (orderIndex.get(b.repoName.toLowerCase()) ?? Infinity)
  || b.stars - a.stars;
const groupOrder = [
  'CLI & System Tools',
  'Security',
  'AI & Machine Learning',
  'Apps & Games',
  'Web',
];
const groupRank = (title: string) => {
  const i = groupOrder.indexOf(title);
  return i === -1 ? groupOrder.length : i;
};
const byCategory = new Map<string, typeof projects>();
for (const project of projects) {
  if (pinnedNames.has(project.repoName)) continue;
  const category = project.category;
  if (!byCategory.has(category)) byCategory.set(category, []);
  byCategory.get(category)!.push(project);
}
const groups = [
  { title: 'Pinned', projects: pinned },
  ...[...byCategory]
    .sort(([a], [b]) => groupRank(a) - groupRank(b))
    .map(([title, list]) => ({ title, projects: [...list].sort(byStrength) })),
];

function getPreviewImage(image: string): string {
  const preview = image.replace(/^\/images\/(.+)\.\w+$/, '/images/previews/$1.webp');
  return existsSync(path.join(process.cwd(), 'public', preview)) ? preview : image;
}

const shotSizes = new Map<string, { width: number; height: number }>();
for (const project of projects) {
  if (!project.image || shotSizes.has(project.image)) continue;
  const { width = 1600, height = 1000 } = await sharp(path.join(process.cwd(), 'public', project.image)).metadata();
  shotSizes.set(project.image, { width, height });
}

function getHostedLabel(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
}
