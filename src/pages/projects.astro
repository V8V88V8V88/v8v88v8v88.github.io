.contrib-chart {
  display: block;
  text-decoration: none;
  color: inherit;
  cursor: pointer;
  margin: 1rem 0 1rem;
  width: 100%;
  max-width: 100%;
  overflow-x: auto;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
  transition: opacity 0.2s ease, transform 0.2s ease;
  /* The grid's width sets its height, so expose both to the placeholder. */
  --contrib-gap: clamp(2px, 0.2vw, 3px);
  container-type: inline-size;
}

.contrib-chart:hover {
  opacity: 0.92;
  transform: translateY(-1px);
}

.hero-intro {
  width: 100%;
}

/* Desktop: the chart fills the empty column beside the heading and tagline
   instead of taking a row of its own. It runs from the heading's top to the
   tagline's bottom, the cells are sized from that height, and as many recent
   weeks as fit are shown, newest on the right, fading into the past on the
   left. The count hangs just below, under the newest weeks. */
@media (min-width: 1100px) {
  .hero-intro {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: clamp(2rem, 4vw, 4.5rem);
  }

  .hero-intro .hero-ascii {
    grid-column: 1;
    grid-row: 1;
  }

  .hero-intro .hero-tagline {
    grid-column: 1;
    grid-row: 2;
    white-space: nowrap;
  }

  .hero-intro .contrib-chart {
    --contrib-gap: 4px;
    --contrib-cell: calc((100cqh - 6 * var(--contrib-gap)) / 7);
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: stretch;
    /* Top on the heading's ink, bottom on the tagline's baseline. */
    margin: 0.2rem 0 calc(1.5rem + 0.75rem);
    /* Size containment keeps the chart out of the row sizing, so the left
       column alone sets the height it stretches to. */
    container-type: size;
    overflow: visible;
    position: relative;
  }

  .hero-intro .contrib-chart :global(.contrib-grid),
  .hero-intro .contrib-chart :global(.contrib-grid:empty) {
    display: flex;
    justify-content: flex-end;
    height: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 40%);
    mask-image: linear-gradient(to right, transparent, #000 40%);
  }

  .hero-intro .contrib-chart :global(.contrib-week) {
    flex: 0 0 var(--contrib-cell);
  }

  .hero-intro .contrib-chart :global(.contrib-cell) {
    border-radius: 3px;
  }

  /* Out of flow, so the grid keeps the full heading-to-tagline height. */
  .hero-intro .contrib-header {
    position: absolute;
    top: 100%;
    right: 0;
    margin: 0.85rem 0 0;
    line-height: 1;
    white-space: nowrap;
  }

  .hero-intro .contrib-count {
    font-size: var(--fs-2xs);
  }

  .hero-intro .contrib-legend {
    display: none;
  }
}

.contrib-header {
  margin-bottom: 0.75rem;
}

/* The count and grid arrive from the contributions API after first paint.
   Hold their final size until then (one text line; 7 square cells + 6 gaps
   at this width) so the stats and projects below never shift. */
.contrib-count:empty::before {
  content: '\a0';
}

.contrib-grid:empty {
  height: calc((100cqw - 52 * var(--contrib-gap)) / 53 * 7 + 6 * var(--contrib-gap));
}

.contrib-count {
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 0.01em;
}

:global(.contrib-grid) {
  display: grid;
  grid-template-columns: repeat(53, minmax(0, 1fr));
  gap: var(--contrib-gap);
  width: 100%;
  min-width: 0;
}

:global(.contrib-week) {
  display: grid;
  grid-template-rows: repeat(7, 1fr);
  gap: var(--contrib-gap);
}

:global(.contrib-cell) {
  aspect-ratio: 1;
  width: 100%;
  border-radius: 2px;
  transition: outline 0.15s ease;
}

:global(.contrib-cell:hover:not(.empty)) {
  outline: 1px solid rgba(255, 255, 255, 0.4);
  outline-offset: 1px;
}

:global(.contrib-cell.empty) {
  visibility: hidden;
}

:global(.contrib-cell.level-0) {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.06);
}

:global(.contrib-cell.level-1) {
