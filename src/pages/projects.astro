              <path d="M10.6 6a2.8 2.8 0 0 1 0 4M12.6 4.2a5.3 5.3 0 0 1 0 7.6" fill="none" stroke="url(#sound-tik-body)" stroke-width="1.1" stroke-linecap="round"/>
