---
import { existsSync } from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects } from '../data/projects';
import { getLanguageMeta } from '../data/languageIcons';

const projects = await getProjects();
const languages = new Set(projects.map(p => p.language));

// Cards show a small square crop of each project image, so use the 560px
// WebP made by scripts/project-previews.mjs when it exists (far less to
// download and decode while scrolling), else the original.
function getPreviewImage(image: string): string {
  const preview = image.replace(/^\/images\/(.+)\.\w+$/, '/images/previews/$1.webp');
  return existsSync(path.join(process.cwd(), 'public', preview)) ? preview : image;
}

function getHostedLabel(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
}
---
<BaseLayout
  title="Projects | V8"
  description="All projects by V8V88V8V88 - Open source, tools, apps, and experiments."
  canonical="https://v8v88v8v88.com/projects/"
>
