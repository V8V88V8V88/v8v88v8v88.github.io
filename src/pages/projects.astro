              <button type="button" class="tech-pill" role="option" data-filter-lang="C/C++">C/C++</button>
              <button type="button" class="tech-pill" role="option" data-filter-lang="Python">Python</button>
              <button type="button" class="tech-pill" role="option" data-filter-lang="TypeScript">TypeScript</button>
