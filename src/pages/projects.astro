/* Touch: a tap just opens the project; no flash, callout or sticky hover state. */
@media (hover: none), (pointer: coarse) {
  .project-main-link,
  .project-hosted {
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
  }

  /* content-visibility only pays off for desktop's hover reflows. While
     scrolling a phone it lays out and paints each row as it enters, and the
     5.6rem placeholder never matches the real row height, so the page
     shifts a little every time one appears. The whole list is cheap enough
     to render up front. */
  .project-item {
    content-visibility: visible;
  }
}

/* Phone type scale. Desktop's hierarchy (ASCII ~1.4x the tagline, tagline
   ~2.4x the card text, stat numbers ~0.84x the tagline, names 1.25x their
   descriptions) used to collapse on phones: the hero shrank to 0.4-0.5x
   while cards and stats barely shrank. These keep a compressed version of
   the same ratios, with descriptions held at a readable 0.8rem. */
@media (max-width: 768px) {
  .hero-ascii {
    font-size: clamp(0.275rem, 1.32vw, 0.47rem);
  }

  .hero-tagline {
    font-size: clamp(1.15rem, 4.6vw + 0.1rem, 1.75rem);
    text-wrap: balance; /* no lone "shipped." when it wraps */
  }

  .contrib-count {
    font-size: var(--fs-2xs);
  }

  .hero-stat-value {
    font-size: 1rem;
  }

  .hero-stat-label {
    font-size: 0.66rem;
  }

  .project-name {
    font-size: var(--fs-sm);
  }
}

/* Touch has no hover, so the dial follows the scroll instead: the row crossing
   the middle of the screen is the focal one and the rest recede with distance,
   matching the desktop hover dial (roughly one row per ~11% of the view
   timeline). Scroll-driven and transform/opacity only, so it runs on the
   compositor with no JS; browsers without scroll timelines keep a flat list. */
@keyframes project-dial {
  0% {
    opacity: 0.3;
    transform: perspective(1200px) rotateX(-10deg) scale(0.92);
  }
  39% {
    opacity: 0.64;
    transform: perspective(1200px) rotateX(-2.5deg) scale(0.98);
  }
  50% {
    opacity: 1;
    transform: perspective(1200px) rotateX(0deg) scale(1.015);
  }
  61% {
    opacity: 0.64;
    transform: perspective(1200px) rotateX(2.5deg) scale(0.98);
  }
  100% {
    opacity: 0.3;
    transform: perspective(1200px) rotateX(10deg) scale(0.92);
  }
}

/* JS fallback dial (no scroll timelines): values are written every scroll
   frame, so transform/opacity must apply directly. Easing them (the hover
   transitions) would restart on every frame and drag the rows behind the
   scroll. */
.project-list.scroll-dial .project-item {
  transition:
    background 0.3s ease,
    border-color 0.3s ease,
    box-shadow 0.35s ease;
}

@supports (animation-timeline: view()) {
  @media (hover: none) and (prefers-reduced-motion: no-preference),
         (pointer: coarse) and (prefers-reduced-motion: no-preference) {
    .project-item {
      animation: project-dial linear both;
      animation-timeline: view();
    }

    /* The dial fades every row, and a fading row with its own compositor
       layer inside has to be drawn offscreen first: one extra GPU render
       pass per visible row per frame (16 instead of 4 while scrolling),
       which tile-based phone GPUs feel as stutter on a fast fling. The
       preview's will-change and the card's backface-visibility only promote
       for the desktop hover/pop-out motion; on touch the preview never
       moves, so dropping them keeps each row a single layer and changes
       nothing on screen. */
    .project-preview {
      will-change: auto;
    }

    .lang-card {
      backface-visibility: visible;
    }
  }
}

/* Same for the JS fallback dial, which fades rows the same way. */
.project-list.scroll-dial .project-preview {
  will-change: auto;
}

.project-list.scroll-dial .lang-card {
  backface-visibility: visible;
}

/* Sound switch: icon only, one speaker per voice in that voice's style:
