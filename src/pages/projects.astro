  transform: translateX(-1.625rem) scale(0.30804);
  transform-origin: center center;
  transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  will-change: transform;
}

/* Generated language icons use one opaque, glass-styled surface. */
.project-preview.has-lang-card {
