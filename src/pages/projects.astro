  </main>

  <script is:inline>
    (function() {
      var chart = document.getElementById('contrib-chart');
      var grid = document.getElementById('contrib-grid');
      var countEl = document.getElementById('contrib-count');
      if (!chart || !grid || !countEl) return;

      fetch('https://github-contributions-api.jogruber.de/v4/V8V88V8V88?y=last')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var contributions = data.contributions || [];
          var total = data.total && data.total.lastYear || 0;
          countEl.textContent = total + ' contributions';
          // Dropped on phones, where the count sits under the narrow chart column.
          var countExtra = document.createElement('span');
          countExtra.className = 'contrib-count-extra';
          countExtra.textContent = ' in the last year';
          countEl.appendChild(countExtra);

          if (contributions.length === 0) { chart.style.display = 'none'; return; }

          var weeks = [];
          var week = [];
          var firstDay = new Date(contributions[0].date).getDay();
          for (var i = 0; i < firstDay; i++) week.push({ date: '', count: 0, level: -1 });
          for (var j = 0; j < contributions.length; j++) {
            week.push(contributions[j]);
            if (week.length === 7) { weeks.push(week); week = []; }
          }
          if (week.length > 0) weeks.push(week);

          var frag = document.createDocumentFragment();
          for (var w = 0; w < weeks.length; w++) {
            var weekDiv = document.createElement('div');
            weekDiv.className = 'contrib-week';
            for (var d = 0; d < weeks[w].length; d++) {
              var day = weeks[w][d];
              var cell = document.createElement('div');
              cell.className = 'contrib-cell ' + (day.level === -1 ? 'empty' : 'level-' + day.level);
              if (day.date) cell.title = day.count + ' contributions on ' + day.date;
              weekDiv.appendChild(cell);
            }
            frag.appendChild(weekDiv);
          }
          grid.appendChild(frag);
        })
        .catch(function() { chart.style.display = 'none'; });
    })();
  </script>

  <script is:inline>
    const langMap = {
      'TypeScript': 'TypeScript',
      'Rust': 'Rust',
      'Python': 'Python',
      'Svelte': 'Svelte',
      'Shell': 'Shell',
      'C++': 'C/C++',
      'C': 'C/C++',
      'Go': 'Others',
      'JavaScript': 'Others',
      'HTML': 'Others',
      'Theme': 'Others',
      'Config': 'Others',
      'Jupyter': 'Others',
      'CSS': 'Others',
      'GDScript': 'Others'
    };

    function initializeProjectLangs() {
      const projectItems = document.querySelectorAll('.project-item');
      projectItems.forEach(item => {
        if (!item.dataset.lang) {
          const langSpan = item.querySelector('.project-lang');
          if (langSpan) {
            const langText = langSpan.textContent.trim();
            item.dataset.lang = langMap[langText] || 'Others';
          }
        }
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      initializeProjectLangs();

      const projectList = document.querySelector('.project-list');
      const langMenu = document.getElementById('lang-menu');
      const langTrigger = document.getElementById('lang-trigger');
      const langOptions = document.getElementById('lang-options');
      const langCurrent = document.getElementById('lang-current');
      const techPills = document.querySelectorAll('.lang-options .tech-pill');
      const allPill = document.querySelector('.tech-pill[data-filter-lang="all"]');
      if (allPill) allPill.classList.add('active');

      function closeLangMenu(refocus) {
        if (!langOptions || langOptions.hidden) return;
        langOptions.hidden = true;
        langTrigger.setAttribute('aria-expanded', 'false');
        if (refocus) langTrigger.focus();
      }
      if (langTrigger && langOptions) {
        langTrigger.addEventListener('click', (e) => {
          e.stopPropagation();
          const open = langOptions.hidden;
          langOptions.hidden = !open;
          langTrigger.setAttribute('aria-expanded', String(open));
          if (open) (langOptions.querySelector('.tech-pill.active') || langOptions.querySelector('.tech-pill')).focus();
        });
        document.addEventListener('click', (e) => {
          if (!langMenu.contains(e.target)) closeLangMenu(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeLangMenu(true);
        });
      }

      techPills.forEach(pill => {
        pill.addEventListener('click', (e) => {
          e.stopPropagation();
          const selectedLang = pill.dataset.filterLang;
          techPills.forEach(p => p.classList.remove('active'));
          pill.classList.add('active');
          if (langCurrent) langCurrent.textContent = selectedLang === 'all' ? 'All' : pill.textContent;
          if (langTrigger) langTrigger.classList.toggle('active', selectedLang !== 'all');
          closeLangMenu(true);
          document.querySelectorAll('.project-item').forEach(item => {
            const itemLang = item.dataset.lang || 'Others';
            item.style.display = (selectedLang === 'all' || itemLang === selectedLang) ? '' : 'none';
          });
        });
      });
      const featuredToggle = document.getElementById('featured-toggle');
      if (featuredToggle && projectList) {
        featuredToggle.addEventListener('click', () => {
          const on = featuredToggle.getAttribute('aria-pressed') !== 'true';
          featuredToggle.setAttribute('aria-pressed', String(on));
          featuredToggle.classList.toggle('active', on);
          projectList.classList.toggle('show-featured-only', on);
        });
      }

      document.querySelectorAll('.project-item').forEach(item => {
        item.addEventListener('mouseleave', () => {
          if (document.activeElement && item.contains(document.activeElement)) {
            document.activeElement.blur();
          }
        });
      });

      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const compact = window.matchMedia('(max-width: 768px)');

      // Dial sounds, three voices, picked with the sound switch in the filter
      // row (every visit starts on 'pup'):
      // - 'pup': a light cartoon "pup" (think Doraemon's footsteps), a short
      //   sine whose pitch flicks up in 30ms with the low end trimmed, at the
      //   same pitch every time.
      // - 'tik': a short, soft picker-wheel detent, a ~12ms band-passed noise
      //   transient over a 30ms tonal body, at a steady pitch.
      // - 'modem': an old dial-up modem connecting, one fragment per row.
      //   Rows step through the V.34/V.90 handshake (DTMF dialling, the ANSam
      //   answer tone, V.21 CM/JM, INFO "ka-king", the A "ding", L1 probing
      //   "pshhh", TRN "tshchch") and keep cycling the noisy tail; a pause
      //   hangs up and the next run dials again. Everything is band-limited
      //   to a phone line (300-3400Hz).
      // No reverb, so nothing rings or gurgles. Image pop-outs use the same
      // voice (up on open, down on close). A hair of random rate variation
      // keeps repeats from sounding mechanical.
      // Each voice is rendered into AudioBuffers with an OfflineAudioContext
      // the first time it's used, so a tick is just one buffer source + gain.
      // A new sound on the same channel fades out the previous one (like
      // use-sound's `interrupt`), so fast runs never pile up.
      // Browsers only allow audio once the visitor has interacted with the
      // page (or the site is allowed to autoplay), so until then it's silent.
      const SOUND_CYCLE = ['pup', 'tik', 'modem'];
      let voice = 'pup';
      // Earlier builds remembered the pick; drop that so visits start on pup.
      try { localStorage.removeItem('sound-voice'); } catch (_) {}
      // Per-voice peak level for a lone tick (see playTick).
      const LEVELS = { tik: 0.08, pup: 0.064, modem: 0.05 };
      let audio = null;
      let unlocking = null;
      const lastTickAt = { tick: 0 };
      const handshake = { step: 0 };
      // Set the first time any sound actually plays; until then the sound
      // switch shimmers and its first press just lets the current voice play.
      let heard = false;
      const onFirstSound = [];
      // Normalise to a 1.0 peak so the play gain below *is* the peak level
      // (gain 0.08 = -22 dBFS) whatever the voice's recipe.
      const normalise = rendered => {
        const samples = rendered.getChannelData(0);
        let peak = 0;
        for (let i = 0; i < samples.length; i++) peak = Math.max(peak, Math.abs(samples[i]));
        if (peak > 0) for (let i = 0; i < samples.length; i++) samples[i] /= peak;
        return rendered;
      };
      // One "pup": a sine sliding from `from` to `to` Hz in 30ms, 2ms attack,
      // gone by 60ms, light (trimmed below 300Hz) and soft above 4kHz.
      const renderPup = async (sampleRate, from, to) => {
        const ctx = new OfflineAudioContext(1, Math.ceil(sampleRate * 0.08), sampleRate);
        const thin = ctx.createBiquadFilter();
        thin.type = 'highpass';
        thin.frequency.value = 300;
        const soften = ctx.createBiquadFilter();
        soften.type = 'lowpass';
        soften.frequency.value = 4000;
        thin.connect(soften).connect(ctx.destination);
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.frequency.setValueAtTime(from, 0);
        osc.frequency.exponentialRampToValueAtTime(to, 0.03);
        gain.gain.setValueAtTime(0.0001, 0);
        gain.gain.exponentialRampToValueAtTime(1, 0.002);
        gain.gain.exponentialRampToValueAtTime(0.0001, 0.06);
        osc.connect(gain).connect(thin);
        osc.start(0);
        osc.stop(0.07);
        return normalise(await ctx.startRendering());
      };
      const renderVoice = async (sampleRate, { body, bodyDecay, tap, tapDecay }) => {
        const length = Math.max(bodyDecay, tapDecay) + 0.03;
        const ctx = new OfflineAudioContext(1, Math.ceil(sampleRate * length), sampleRate);
        const soften = ctx.createBiquadFilter();
        soften.type = 'lowpass';
        soften.frequency.value = 5000;
        soften.connect(ctx.destination);

        // Tonal body: a sine with a 3ms attack and an exponential fall.
        const osc = ctx.createOscillator();
        const bodyGain = ctx.createGain();
        osc.frequency.value = body;
        bodyGain.gain.setValueAtTime(0.0001, 0);
        bodyGain.gain.exponentialRampToValueAtTime(0.5, 0.003);
        bodyGain.gain.exponentialRampToValueAtTime(0.0001, bodyDecay);
        osc.connect(bodyGain).connect(soften);
        osc.start(0);
        osc.stop(bodyDecay + 0.01);

        // Tap: white noise through a wide band-pass, 1ms attack.
        const noise = ctx.createBuffer(1, Math.ceil(sampleRate * (tapDecay + 0.01)), sampleRate);
        const data = noise.getChannelData(0);
        for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
        const tapSource = ctx.createBufferSource();
        tapSource.buffer = noise;
        const band = ctx.createBiquadFilter();
        band.type = 'bandpass';
        band.frequency.value = tap;
        band.Q.value = 0.8;
        const tapGain = ctx.createGain();
        tapGain.gain.setValueAtTime(0.0001, 0);
        tapGain.gain.exponentialRampToValueAtTime(0.6, 0.001);
        tapGain.gain.exponentialRampToValueAtTime(0.0001, tapDecay);
        tapSource.connect(band).connect(tapGain).connect(soften);
        tapSource.start(0);

        return normalise(await ctx.startRendering());
      };
      // Modem fragments: `build` schedules tones/noise into a 4ms-faded
      // envelope that feeds a phone-line band-pass.
      const renderLine = async (sampleRate, duration, build) => {
        const ctx = new OfflineAudioContext(1, Math.ceil(sampleRate * (duration + 0.01)), sampleRate);
        const lineLow = ctx.createBiquadFilter();
        lineLow.type = 'highpass';
        lineLow.frequency.value = 300;
        const lineHigh = ctx.createBiquadFilter();
        lineHigh.type = 'lowpass';
        lineHigh.frequency.value = 3400;
        const envelope = ctx.createGain();
        envelope.gain.setValueAtTime(0, 0);
        envelope.gain.linearRampToValueAtTime(1, 0.004);
        envelope.gain.setValueAtTime(1, duration - 0.008);
        envelope.gain.linearRampToValueAtTime(0, duration);
        envelope.connect(lineLow).connect(lineHigh).connect(ctx.destination);
        build(ctx, envelope, duration);
        return normalise(await ctx.startRendering());
      };
      const lineTone = (ctx, dest, freq, end, level = 1) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        gain.gain.value = level;
        osc.frequency.value = freq;
        osc.connect(gain).connect(dest);
        osc.start(0);
        osc.stop(end);
        return osc;
      };
      // A white-noise buffer source of the given length.
      const whiteNoise = (ctx, sampleRate, duration) => {
        const noise = ctx.createBuffer(1, Math.ceil(sampleRate * duration), sampleRate);
        const data = noise.getChannelData(0);
        for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
        const source = ctx.createBufferSource();
        source.buffer = noise;
        return source;
      };
      // The V.34/V.90 handshake, stage by stage (ITU-T V.8/V.21/V.34 values).
      const renderModem = sampleRate => {
        // Dialling: DTMF digit pairs.
        const dtmf = (low, high) => renderLine(sampleRate, 0.07, (ctx, dest, d) => {
          lineTone(ctx, dest, low, d, 0.5);
          lineTone(ctx, dest, high, d, 0.5);
        });
        // ANSam: 2100Hz answer tone with a 15Hz, +/-20% amplitude wobble.
        const answer = renderLine(sampleRate, 0.12, (ctx, dest, d) => {
          const am = ctx.createGain();
          am.gain.value = 0.8;
          am.connect(dest);
          lineTone(ctx, am, 2100, d);
          const lfo = ctx.createOscillator();
          const depth = ctx.createGain();
          lfo.frequency.value = 15;
          depth.gain.value = 0.2;
          lfo.connect(depth).connect(am.gain);
          lfo.start(0);
          lfo.stop(d);
        });
        // V.21 FSK at 300 baud: CM on the low channel (980/1180Hz), JM on the
        // high channel (1650/1850Hz), random bits.
        const fsk = (mark, space) => renderLine(sampleRate, 0.1, (ctx, dest, d) => {
          const osc = lineTone(ctx, dest, mark, d);
          for (let t = 0; t < d; t += 1 / 300) osc.frequency.setValueAtTime(Math.random() < 0.5 ? mark : space, t);
        });
        // Phase flips: a tone through a gain switched between +1 and -1.
        const phased = (ctx, dest, freq, d, flips) => {
          const sign = ctx.createGain();
          sign.connect(dest);
          lineTone(ctx, sign, freq, d);
          flips.forEach(([t, value]) => sign.gain.setValueAtTime(value, t));
        };
        // INFO at 600bps DPSK on the 2400Hz carrier: the "ka-king".
        const kaking = renderLine(sampleRate, 0.1, (ctx, dest, d) => {
          const flips = [];
          for (let t = 0, v = 1; t < d; t += 1 / 600) flips.push([t, v = Math.random() < 0.5 ? -v : v]);
          phased(ctx, dest, 2400, d, flips);
        });
        // A: 2400Hz tone with a phase reversal, the "ding".
        const ding = (freq, duration) => renderLine(sampleRate, duration, (ctx, dest, d) => {
          phased(ctx, dest, freq, d, [[0, 1], [d / 2, -1]]);
        });
        // L1/L2 line probing: 21 tones 150Hz apart (150-3750Hz), the "pshhh".
        const probe = renderLine(sampleRate, 0.1, (ctx, dest, d) => {
          for (let k = 1; k <= 25; k++) {
            if ([4, 6, 8, 10].includes(k)) continue; // V.34 omits a few to get 21
            lineTone(ctx, dest, 150 * k, d, 0.25);
          }
        });
        // TRN: scrambled data around the 1800Hz carrier, the "tshchchch".
        const training = renderLine(sampleRate, 0.1, (ctx, dest, d) => {
          const source = whiteNoise(ctx, sampleRate, d);
          const band = ctx.createBiquadFilter();
          band.type = 'bandpass';
          band.frequency.value = 1800;
          band.Q.value = 0.6;
          source.connect(band).connect(dest);
          source.start(0);
        });
        const hangUp = renderLine(sampleRate, 0.12, (ctx, dest, d) => {
          const osc = lineTone(ctx, dest, 1400, d);
          osc.frequency.exponentialRampToValueAtTime(500, d);
        });
        // "Connected": the A then B probe tones, ding-dong.
        const connected = renderLine(sampleRate, 0.2, (ctx, dest, d) => {
          const a = ctx.createGain();
          const b = ctx.createGain();
          a.connect(dest);
          b.connect(dest);
          lineTone(ctx, a, 2400, d);
          lineTone(ctx, b, 1200, d);
          a.gain.setValueAtTime(1, 0);
          a.gain.setValueAtTime(0, d / 2);
          b.gain.setValueAtTime(0, 0);
          b.gain.setValueAtTime(1, d / 2);
        });
        return Promise.all([
          dtmf(697, 1209), dtmf(770, 1477), dtmf(852, 1336), dtmf(941, 1209),
          answer, fsk(980, 1180), fsk(1650, 1850), kaking, ding(2400, 0.09), probe, training,
          connected, hangUp,
        ]).then(parts => ({ tick: parts.slice(0, 11), open: parts[11], close: parts[12] }));
      };
      const asSet = parts => parts.then(([tick, open, close]) => ({ tick, open, close }));
      const RECIPES = {
        pup: rate => asSet(Promise.all([
          renderPup(rate, 700, 1200),
          renderPup(rate, 600, 1300),
          renderPup(rate, 1100, 600),
        ])),
        tik: rate => asSet(Promise.all([
          renderVoice(rate, { body: 880, bodyDecay: 0.03, tap: 2600, tapDecay: 0.012 }),
          renderVoice(rate, { body: 660, bodyDecay: 0.07, tap: 2200, tapDecay: 0.018 }),
          renderVoice(rate, { body: 520, bodyDecay: 0.05, tap: 2000, tapDecay: 0.014 }),
        ])),
        modem: rate => renderModem(rate),
      };
      // Renders a voice the first time it's needed (a few ms of work).
      const ensureVoice = name => {
        if (!audio || !RECIPES[name]) return Promise.resolve();
        if (!audio.pending[name]) {
          audio.pending[name] = RECIPES[name](audio.ctx.sampleRate)
            .then(set => { audio.voices[name] = set; })
            .catch(() => { audio.pending[name] = null; });
        }
        return audio.pending[name];
      };
      // Creates the context once (one shared promise, however many gestures
      // fire meanwhile) and renders the current voice; later calls resume.
      const unlockAudio = () => {
        if (audio) {
          if (audio.ctx.state !== 'running') audio.ctx.resume();
          return ensureVoice(voice);
        }
        if (!unlocking) {
          unlocking = (async () => {
            try {
              const ctx = new (window.AudioContext || window.webkitAudioContext)();
              if (ctx.state !== 'running') ctx.resume();
              audio = { ctx, voices: {}, pending: {}, playing: {} };
              await ensureVoice(voice);
            } catch (_) {
              unlocking = null;
            }
          })();
        }
        return unlocking;
      };
      ['pointerdown', 'pointerup', 'touchend', 'click', 'keydown'].forEach(type => {
        window.addEventListener(type, unlockAudio, { passive: true });
      });
      // Where the site is already allowed to play sound (e.g. the visitor
      // granted autoplay), start without waiting for a click.
      if (navigator.getAutoplayPolicy && navigator.getAutoplayPolicy('audiocontext') === 'allowed') unlockAudio();
      document.addEventListener('visibilitychange', () => {
        if (!audio) return;
        if (document.hidden) audio.ctx.suspend();
        else audio.ctx.resume();
      });
      const play = (channel, buffer, volume, rate = 1) => {
        if (!audio || audio.ctx.state !== 'running') return;
        const { ctx, playing } = audio;
        const t = ctx.currentTime;
        const previous = playing[channel];
        if (previous) {
          previous.gain.gain.setTargetAtTime(0, t, 0.012);
          previous.source.stop(t + 0.08);
        }
        const source = ctx.createBufferSource();
        const gain = ctx.createGain();
        source.buffer = buffer;
        source.playbackRate.value = rate;
        gain.gain.value = volume;
        source.connect(gain).connect(ctx.destination);
        source.start(t);
        playing[channel] = { source, gain };
        if (!heard) {
          heard = true;
          onFirstSound.forEach(fn => fn());
        }
        source.onended = () => {
          if (playing[channel] && playing[channel].source === source) playing[channel] = null;
        };
      };
      const playTick = () => {
        const now = performance.now();
        const gap = now - lastTickAt.tick;
        if (gap < 70) return;
        lastTickAt.tick = now;
        const set = audio && audio.voices[voice];
        if (!set) return;
        const rate = 0.99 + Math.random() * 0.02;
        let buffer = set.tick;
        if (Array.isArray(buffer)) {
          // Modem: advance through the handshake, then keep cycling its
          // ka-king / pshhh / tshch tail; a pause (hang up) dials again.
          if (gap > 600) handshake.step = 0;
          const last = buffer.length - 1;
          const tail = [last - 3, last - 1, last]; // kaking, probe, training
          const i = handshake.step <= last ? handshake.step : tail[(handshake.step - last - 1) % 3];
          handshake.step++;
          buffer = buffer[i];
        }
        // Peak levels follow common UI-sound guidance (repeated feedback around
        // -18 to -24 dB, hover gain 0.03-0.08): a lone tick peaks at -22 dBFS,
        // quick runs (fast scroll or sweep) ease down to about -30 dBFS.
        // The 'pup' is a pure tone near where the ear is most sensitive, so it
        // plays ~2 dB under the 'tik' for the same perceived level.
        // The modem fragments are dense, full-band sounds, so they sit lower.
        play('tick', buffer, LEVELS[voice] * Math.min(1, 0.4 + gap / 250), rate);
      };
      const playPop = open => {
        const set = audio && audio.voices[voice];
        if (!set) return;
        const level = LEVELS[voice] / LEVELS.tik;
        if (open) play('pop', set.open, 0.1 * level);
        else play('pop', set.close, 0.08 * level);
      };

      // Sound switch in the filter row: cycles pup -> tik -> modem (its icon
      // shows which) and plays a short sample of the new voice. The click is itself the gesture browsers need for audio. Until
      // any sound has been heard it shimmers, and its first press doesn't
      // switch, it just plays the current voice so sound is simply "on".
      const soundToggle = document.getElementById('sound-toggle');
      const showVoice = () => {
        if (!soundToggle) return;
        const label = heard ? `Sound: ${voice}, click to switch` : 'Play sound effects';
        soundToggle.dataset.voice = voice;
        soundToggle.setAttribute('aria-label', label);
        soundToggle.setAttribute('title', label);
      };
      showVoice();
      if (soundToggle) {
        // The glint animates a mask, which can't run on the compositor, so it
        // costs a main-thread frame every vsync; scrolling the list would pay
        // that the whole way down. Pause it while the button is off-screen.
        const glintIO = new IntersectionObserver(([entry]) => {
          soundToggle.classList.toggle('glint-paused', !entry.isIntersecting);
        });
        glintIO.observe(soundToggle);
        onFirstSound.push(() => {
          soundToggle.classList.remove('is-idle');
          glintIO.disconnect();
          showVoice();
        });
        soundToggle.addEventListener('click', async () => {
          if (heard) {
            voice = SOUND_CYCLE[(SOUND_CYCLE.indexOf(voice) + 1) % SOUND_CYCLE.length];
          }
          handshake.step = 0;
          showVoice();
          await unlockAudio();
          if (!audio) return;
          if (audio.ctx.state !== 'running') await audio.ctx.resume();
          const wait = ms => new Promise(resolve => setTimeout(resolve, ms));
          const picked = voice;
          for (let k = 0; k < (picked === 'modem' ? 6 : 3) && voice === picked; k++) {
            playTick();
            await wait(140);
          }
        });
      }
      // A hovered row grows (desc wraps to two lines, hosted link appears).
      // Cancel that growth with an equal negative margin so the rows below
      // never shift; the active row simply overlaps the next one. Resize
      // observer callbacks run after layout and before paint, so the
      // compensation lands in the same frame as each step of the transition.
      const baseHeights = new WeakMap();
      const isEngaged = item => item.matches(':hover') || item.contains(document.activeElement);
      const rowResizeObserver = canHover ? new ResizeObserver(entries => {
        entries.forEach(entry => {
          const item = entry.target;
          const height = item.offsetHeight;
          if (!item.classList.contains('cv-active')) {
            baseHeights.set(item, {
              height,
              margin: parseFloat(getComputedStyle(item).marginBottom) || 0,
            });
            return;
          }
          const base = baseHeights.get(item);
          if (!base) return;
          item.style.marginBottom = height > base.height ? `${base.margin + base.height - height}px` : '';
        });
      }) : null;
      document.querySelectorAll('.project-item').forEach(item => {
        if (!canHover) return;
        // Hover growth is mostly padding (the hosted-link gap), which a default
        // content-box observer never reports.
        rowResizeObserver.observe(item, { box: 'border-box' });
        let revertTimer = null;
        const activate = () => {
          clearTimeout(revertTimer);
          item.classList.add('cv-active');
        };
        const scheduleDeactivate = () => {
          clearTimeout(revertTimer);
          revertTimer = setTimeout(() => {
            if (!isEngaged(item)) {
              item.classList.remove('cv-active');
              item.style.marginBottom = '';
            }
          }, 480);
        };
        item.addEventListener('mouseenter', activate);
        item.addEventListener('mouseleave', scheduleDeactivate);
        item.addEventListener('focusin', activate);
        item.addEventListener('focusout', scheduleDeactivate);

        // Only real project images pop out, and only on purpose: hovering the
        // image (after a short intent delay) or clicking it. A click toggles,
        // and a pinned image stays open until the pointer leaves the row.
        const preview = item.querySelector('.project-preview.has-custom-image');
        if (!preview) return;
        let openTimer = null;
        let pinned = false;
        let suppressed = false;
        const setOpen = open => {
          const next = open && !compact.matches;
          if (item.classList.contains('preview-open') === next) return;
          item.classList.toggle('preview-open', next);
          playPop(next);
        };
        preview.addEventListener('mouseenter', () => {
          clearTimeout(openTimer);
          if (!suppressed) openTimer = setTimeout(() => setOpen(true), 80);
        });
        preview.addEventListener('mouseleave', () => {
          clearTimeout(openTimer);
          suppressed = false;
          if (!pinned) setOpen(false);
        });
        preview.addEventListener('click', () => {
          clearTimeout(openTimer);
          const open = !item.classList.contains('preview-open');
          pinned = open;
          suppressed = !open;
          setOpen(open);
        });
        item.addEventListener('mouseleave', () => {
          clearTimeout(openTimer);
          pinned = false;
          suppressed = false;
          setOpen(false);
        });
        item.addEventListener('focusin', () => {
          if (item.querySelector(':focus-visible')) setOpen(true);
        });
        item.addEventListener('focusout', () => {
          if (!pinned && !item.matches(':hover')) setOpen(false);
        });
      });

      // Fisheye dial: every visible row gets its distance from the focal
      // (hovered/focused) row, and CSS turns that into depth, so neighbours sit
      // just below the focal row and rows recede the further away they are.
      // Distance counts only rows the language/featured filters leave visible.
      if (canHover && projectList) {
        const rows = [...projectList.querySelectorAll('.project-item')];
        const isShown = row => row.style.display !== 'none'
          && (row.classList.contains('featured') || !projectList.classList.contains('show-featured-only'));
        let focal = null;
        const setFocal = item => {
          if (!item || item === focal) return;
          focal = item;
          const shown = rows.filter(isShown);
          const at = shown.indexOf(item);
          playTick();
          shown.forEach((row, i) => {
            const d = i - at;
            const dist = String(Math.min(Math.abs(d), 4));
            const dir = String(Math.sign(d));
            // Skip unchanged rows (most of the list sits at the 4 cap) so a
            // focal change only restyles the handful of rows that move.
            if (row.style.getPropertyValue('--fe-d') !== dist) row.style.setProperty('--fe-d', dist);
            if (row.style.getPropertyValue('--fe-dir') !== dir) row.style.setProperty('--fe-dir', dir);
          });
        };
        const onEnter = e => setFocal(e.target.closest('.project-item'));
        projectList.addEventListener('mouseover', onEnter);
        projectList.addEventListener('focusin', onEnter);
        projectList.addEventListener('mouseleave', () => { focal = null; });
      }

      // Touch dial fallback for browsers without CSS scroll timelines (Firefox,
      // so Zen too): same depth curve as the project-dial keyframes, driven by
      // each nearby row's distance from the middle of the screen. Reads all
      // rects first, then writes, once per frame; only rows near the viewport
      // are touched.
      const isTouch = window.matchMedia('(hover: none)').matches || window.matchMedia('(pointer: coarse)').matches;
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Touch dial tick: a thin observer band across the middle of the screen
      // reports whichever row crosses it, so scrolling clicks through rows like
      // the desktop hover dial without any per-scroll work.
      if (projectList && isTouch) {
        const rows = [...projectList.querySelectorAll('.project-item')];
        let centerIndex = -1;
        const centerIO = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            const i = rows.indexOf(entry.target);
            if (i === centerIndex) return;
            centerIndex = i;
            playTick();
          });
        }, { rootMargin: '-49.5% 0px -49.5% 0px' });
        rows.forEach(row => centerIO.observe(row));
      }
      if (projectList && isTouch && !calm && !CSS.supports('animation-timeline: view()')) {
        const nearby = new Set();
        const lerp = (a, b, t) => a + (b - a) * t;
        const depth = d => {
          const a = Math.min(Math.abs(d), 4);
          const t = a <= 1 ? a : (a - 1) / 3;
          const [o, sc, r] = a <= 1
            ? [lerp(1, 0.64, t), lerp(1.015, 0.98, t), lerp(0, 2.5, t)]
            : [lerp(0.64, 0.3, t), lerp(0.98, 0.92, t), lerp(2.5, 10, t)];
          return [o, sc, -Math.sign(d) * r];
        };
        // Every row written is re-rendered that frame, and the depth curve is
        // flat past four rows out, so most nearby rows hold the same values
        // frame after frame. Only rows whose values actually change are
        // written: about the eight around the middle instead of ~22.
        const written = new Map();
        let queued = false;
        const update = () => {
          queued = false;
          const mid = window.innerHeight / 2;
          const rects = [...nearby].map(row => [row, row.getBoundingClientRect()]);
          rects.forEach(([row, rect]) => {
            const [o, sc, r] = depth((rect.top + rect.height / 2 - mid) / (rect.height + 10));
            const opacity = o.toFixed(3);
            const transform = `perspective(1200px) rotateX(${r.toFixed(2)}deg) scale(${sc.toFixed(4)})`;
            const last = written.get(row);
            if (last && last[0] === opacity && last[1] === transform) return;
            written.set(row, [opacity, transform]);
            row.style.opacity = opacity;
            row.style.transform = transform;
          });
        };
        const queue = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(update);
        };
        const io = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) nearby.add(entry.target);
            else nearby.delete(entry.target);
          });
          queue();
        }, { rootMargin: '50% 0px' });
        projectList.classList.add('scroll-dial');
        projectList.querySelectorAll('.project-item').forEach(row => io.observe(row));
        window.addEventListener('scroll', queue, { passive: true });
        window.addEventListener('resize', queue, { passive: true });
      }

      document.querySelectorAll('.project-main-link, .project-hosted').forEach(link => {
        link.addEventListener('click', function() {
          this.blur();
        });
      });
    });
  </script>
</BaseLayout>

